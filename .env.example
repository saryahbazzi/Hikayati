# ───────── Hikayati environment ─────────
# Copy to .env.local for local development. Never commit real values.

# Required in production: 16+ random characters. Signs guest links and entry passes.
HIKAYATI_SECRET=

# Demo/dev access: seeded FICTIONAL accounts + a visible OTP code + simulated check-in.
# Defaults to ON in development and OFF in production. To review a Vercel *preview*, set it to "true"
# for the Preview environment only — never for Production.
HIKAYATI_DEMO_ACCESS=

# Database. Unset → local PGlite (real Postgres in WASM) stored in HIKAYATI_DATA_DIR (default ./.data/pglite).
# On serverless hosts (Vercel) the filesystem is ephemeral, so set DATABASE_URL for anything you want to keep.
DATABASE_URL=
HIKAYATI_DATA_DIR=

# Public origin used in guest links (optional; derived from the request when unset).
NEXT_PUBLIC_SITE_URL=

# Optional ambient background for the About section (owner-supplied media only).
NEXT_PUBLIC_ABOUT_VIDEO_URL=
NEXT_PUBLIC_ABOUT_POSTER_URL=

# Messaging: "demo" (default; nothing is sent) or "whatsapp" (future official provider; not implemented).
MESSAGING_PROVIDER=demo
# OTP delivery provider id (none implemented yet; without one, production sign-in is disabled unless demo access is on).
OTP_PROVIDER=

# Bearer secret for /api/cron/reminders. Unset → endpoint disabled.
CRON_SECRET=
